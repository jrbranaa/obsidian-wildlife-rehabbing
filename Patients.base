filters:
  and:
    - file.ext == "md"
    - species != null
properties:
  note.species:
    displayName: Species
  note.intake_date:
    displayName: Intake
  note.release_date:
    displayName: Released
  note.intake_age:
    displayName: Age at intake
  note.disposition:
    displayName: Disposition
  note.release_site:
    displayName: Release site
  note.transferred_to:
    displayName: Transferred to
  note.transfer_in_date:
    displayName: Transfer in
  note.transfer_from:
    displayName: Transferred from
  note.transfer_out_date:
    displayName: Transfer out
  note.group:
    displayName: Group
views:
  - type: table
    name: In care
    filters:
      and:
        - disposition == "in care"
    order:
      - file.name
      - species
      - sex
      - intake_date
      - intake_age
      - group
    sort:
      - property: intake_date
        direction: DESC
  - type: table
    name: By group
    filters:
      and:
        - disposition == "in care"
        - group != null
    order:
      - group
      - file.name
      - species
      - intake_age
    sort:
      - property: group
        direction: ASC
  - type: table
    name: Released
    filters:
      and:
        - disposition == "released"
    order:
      - file.name
      - species
      - intake_date
      - release_date
      - release_site
    sort:
      - property: release_date
        direction: DESC
  - type: table
    name: Transferred
    filters:
      and:
        - disposition == "transferred"
    order:
      - file.name
      - species
      - intake_date
      - transfer_from
      - transfer_in_date
      - departure_date
      - transfer_out_date
      - transferred_to
    sort:
      - property: departure_date
        direction: DESC
  - type: table
    name: Did not survive
    filters:
      and:
        - disposition == "died" || disposition == "euthanized" || disposition == "DOA"
    order:
      - file.name
      - species
      - intake_date
      - departure_date
      - disposition
    sort:
      - property: departure_date
        direction: DESC
  - type: table
    name: All patients
    order:
      - file.name
      - species
      - disposition
      - intake_date
    sort:
      - property: intake_date
        direction: DESC
