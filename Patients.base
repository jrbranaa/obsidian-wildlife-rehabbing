filters:
  and:
    - file.ext == "md"
    - species != null
properties:
  note.species:
    displayName: Species
  note.intake_date:
    displayName: Intake
  note.release_date:
    displayName: Released
  note.intake_age:
    displayName: Age at intake
  note.disposition:
    displayName: Disposition
views:
  - type: table
    name: In care
    filters:
      and:
        - disposition == "in care"
    order:
      - file.name
      - species
      - sex
      - intake_date
      - intake_age
    sort:
      - property: intake_date
        direction: DESC
  - type: table
    name: Released
    filters:
      and:
        - disposition == "released"
    order:
      - file.name
      - species
      - intake_date
      - release_date
    sort:
      - property: release_date
        direction: DESC
  - type: table
    name: Did not survive
    filters:
      and:
        - disposition == "died" || disposition == "euthanized" || disposition == "DOA"
    order:
      - file.name
      - species
      - intake_date
      - departure_date
      - disposition
    sort:
      - property: departure_date
        direction: DESC
  - type: table
    name: All patients
    order:
      - file.name
      - species
      - disposition
      - intake_date
    sort:
      - property: intake_date
        direction: DESC
